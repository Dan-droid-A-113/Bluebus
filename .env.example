# BlueBus Environment Configuration
# To connect to Neon Serverless PostgreSQL or any Cloud PostgreSQL DBMS:
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# To fallback to local SQLite for offline development:
# DATABASE_URL=sqlite:///./bluebus.db

# JWT & Security
SECRET_KEY=bluebus-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
